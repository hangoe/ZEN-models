{
  "analysis": {
    "dataset": "snapshot"
  },
  "solver": {
    "name": "gurobi",
    "solver_options": {
      "Method": 2,
      "NodeMethod": 2,
      "BarHomogeneous": 1,
      "DualReductions": 0,
      "Threads": 10,
      "Crossover": 0,
      "ScaleFlag": 2,
      "BarOrder": 0,
      "BarIterLimit": 3000
    },
    "save_duals": true,
    "use_scaling": false,
    "run_diagnostics": true,
    "scaling_include_rhs": true
  },
  "plugins": {
    "mga": {
      "mode": "batch",
      "epsilon": 0.1,
      "normalisation": "relative",
      "batch": {
        "tolerance_prob": 0.95,
        "max_iterations": 800,
        "tolerance_explore": 0.1,
        "n_samples": 2000,
        "alpha": 0.05,
        "method": "jeffreys",
        "use_bounding_box": false,
        "strategy_mode": "bbo",
        "max_function_evaluations": 2000,
        "n_restarts": 1,
        "batch_size": 4,
        "n_workers": 4
      }
    }
  }
}
