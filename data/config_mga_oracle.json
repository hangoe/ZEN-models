{
  "analysis": {
    "dataset": "snapshot"
  },
  "solver": {
    "name": "gurobi",
    "solver_options": {
      "Method": 2,
      "NodeMethod": 2,
      "BarHomogeneous": 1,
      "DualReductions": 0,
      "Threads": 10,
      "Crossover": 0,
      "ScaleFlag": 2,
      "BarOrder": 0,
      "BarIterLimit": 3000
    },
    "save_duals": true,
    "use_scaling": false,
    "run_diagnostics": true,
    "scaling_include_rhs": true
  }, 
  "plugins": {
    "mga": {
      "mode": "oracle",
      "epsilon": 0.01,
      "normalisation": "relative",
      "oracle": {
        "tolerance": 0.1,
        "max_iterations": 700,
        "max_min": {
          "formulation": "kkt_milp",
          "t_max": 1.0,
          "big_M": 1e5,
          "solver_options": {
            "OutputFlag": 1,
            "MIPGap": 0.02,
            "MIPGapAbs": 0.01,
            "TimeLimit": 120,
            "Threads": 10
          },
          "certificate_time_limit": 43200
        }
      }
    }
  }
}
